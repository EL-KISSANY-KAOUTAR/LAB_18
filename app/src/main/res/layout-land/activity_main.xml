<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MODEEEE SOMBREEEEEE"
        android:textColor="#C9A84C"
        android:textSize="14sp"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/tvv__Counterrr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="90sp"
        android:textStyle="bold"
        android:layout_marginBottom="40dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/boutton__Incrementtttt"
        android:layout_width="220dp"
        android:layout_height="56dp"
        android:text="Ajouter"
        app:backgroundTint="#C9A84C"
        android:textColor="#000000"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/boutton__Decrementtttt"
        android:layout_width="220dp"
        android:layout_height="56dp"
        android:text="Retirer"
        app:backgroundTint="#444444"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bouttnResettt"
        android:layout_width="220dp"
        android:layout_height="56dp"
        android:text="Réinitialiser"
        app:backgroundTint="#222222"
        android:textColor="#FFFFFF" />

</LinearLayout>